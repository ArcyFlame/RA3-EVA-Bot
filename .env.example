# ── Core (required) ─────────────────────────────────────────────────────
# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Path to the SQLite database file (default: ./data/bot.db)
# DATABASE_PATH=./data/bot.db

# Production uses global commands and cleans up duplicate server copies.
# For a separate development bot only, set COMMAND_SCOPE=guild and GUILD_ID.
# COMMAND_SCOPE=global
# GUILD_ID=

# Fallback admin role ID (snowflake). Per-guild role via /setup takes precedence.
# ADMIN_ROLE_ID=

# Bot owner user ID (snowflake). Strongly recommended — gates /kill and /restart.
# OWNER_ID=

# ── Challonge (optional — tournament commands degrade gracefully) ────────
# CHALLONGE_API_KEY=
# CHALLONGE_SUBDOMAIN=

# ── Twitch (optional — notifier disabled when absent) ────────────────────
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_REFRESH_TOKEN=

# ── YouTube (optional) ────────────────────────────────────────────────────
# Upload notifications work KEY-FREE via RSS polling; these are only needed
# for instant PubSubHubbub push notifications on a public callback URL.
# YOUTUBE_CALLBACK_BASE=https://your-host.example
# YOUTUBE_VERIFY_TOKEN=
# Shared secret for X-Hub-Signature HMAC verification of PubSubHubbub pushes.
# YOUTUBE_CALLBACK_SECRET=

# ── Misc ──────────────────────────────────────────────────────────────────
# STEAM_API_KEY=
# PUBLIC_CALLBACK_URL=https://your-host.example
# WEBHOOK_PORT=8081

# ── Logging ───────────────────────────────────────────────────────────────
# error | warn | audit | info | debug  (default: debug in dev, info in prod)
# LOG_LEVEL=info
# Optional file log path (e.g. ./logs/bot.log)
# LOG_FILE=

# ── Managed hosting / stable-release updates ──────────────────────────────
# npm start supervises the bot. Updates are disabled until explicitly enabled.
# Only published stable releases from ArcyFlame/RA3-EVA-Bot are accepted.
# AUTO_UPDATE_ENABLED=true
# Check interval in minutes (60–10080; default: 360).
# AUTO_UPDATE_INTERVAL_MINUTES=360
# Requires Git, npm and writable .updates/. The current code stays untouched.
# .env and DATABASE_PATH remain shared; backups are made before switching.
