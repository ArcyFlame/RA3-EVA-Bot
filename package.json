{
  "name": "ra3-community-bot",
  "version": "5.0.0",
  "description": "Community bot for Red Alert 3 and Generals Evolution",
  "license": "GPL-3.0-or-later",
  "botUpdater": {
    "protocol": 1,
    "schemaVersion": 34
  },
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node scripts/host-bot.js",
    "start:direct": "node dist/index.js",
    "stop": "node scripts/stop-host.js",
    "update:check": "node scripts/check-update.js",
    "dev": "node --watch -r ts-node/register/transpile-only src/index.ts",
    "lint": "eslint src scripts/host-bot.js scripts/host-worker.js scripts/lib/updater.js scripts/stop-host.js scripts/check-update.js scripts/validate-update.js",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "diagnose": "node scripts/diagnostics.js",
    "backup:database": "node scripts/backup-database.js",
    "register:commands": "node scripts/register-commands.js",
    "seed:masters": "node scripts/seed-masters.js",
    "backfill:tournament-winners": "npm run build && node scripts/backfill-tournament-winners.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "better-sqlite3": "^12.10.0",
    "canvas": "^3.2.3",
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "cheerio": "^1.0.0-rc.12",
    "discord.js": "^14.27.0",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "winston": "^3.11.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^20.19.41",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "undici@^6": "^6.28.1",
    "undici@^7": "^7.29.1",
    "ip-address": "^10.7.1",
    "js-yaml": "^4.3.2",
    "proxy-addr": "^2.0.8",
    "brace-expansion@^1": "^1.1.21",
    "brace-expansion@^2": "^2.1.7"
  }
}
